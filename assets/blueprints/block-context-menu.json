{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/post.php?post=1&action=edit",
	"login": true,
	"features": {
		"networking": true
	},
	"preferredVersions": {
		"php": "latest",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/bacoords/gutenberg/releases/download/block-context-menu-playground-868559f/gutenberg-block-context-menu-868559f.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Block Context Menu Demo"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; wp_update_post( array( 'ID' => 1, 'post_title' => 'Block Context Menu Demo', 'post_status' => 'draft', 'post_content' => '<!-- wp:paragraph --><p>Right-click this paragraph to open the block menu.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Select both paragraphs, then right-click either one.</p><!-- /wp:paragraph --><!-- wp:group --><div class=\"wp-block-group\"><!-- wp:paragraph --><p>Right-click this nested paragraph.</p><!-- /wp:paragraph --></div><!-- /wp:group -->' ) );"
		}
	]
}
